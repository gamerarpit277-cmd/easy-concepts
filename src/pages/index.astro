---
import Layout from "../layouts/Layout.astro";
import ReviewCard from "../components/ReviewCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { site, reviews, highlights, reviewTags, courses, pillars, faqs } from "../data/site";

const steps = [
  { n: "01", title: "Understand", text: "Every topic starts from the “why” with real-life examples and visuals." },
  { n: "02", title: "Practise", text: "Graded worksheets move from easy to exam-level, at the child’s pace." },
  { n: "03", title: "Clarify", text: "Dedicated doubt time — no question is too small to ask." },
  { n: "04", title: "Test & review", text: "Regular tests with feedback shared with parents." },
];
---

<Layout>
  <!-- Hero -->
  <section class="bg-grid relative overflow-hidden">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 pt-14 pb-20 sm:px-6 lg:grid-cols-2 lg:pt-20 lg:pb-28">
      <div>
        <a
          href={site.mapsUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-white px-3 py-1.5 text-sm shadow-sm transition hover:border-navy-600/30"
        >
          <span class="text-saffron-500">★★★★★</span>
          <span class="font-semibold">{site.rating.toFixed(1)}</span>
          <span class="text-ink/60">from {site.reviewCount} Google reviews</span>
        </a>
        <h1 class="mt-6 font-display text-[2.6rem] leading-[1.08] font-semibold tracking-tight text-navy-900 sm:text-6xl">
          Where tough concepts become <span class="marker">easy</span>.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink/70">
          Easy Concepts is a women-led coaching institute in Matiala, Delhi. Experienced, caring teachers help students from
          Class 1 to 12 build real understanding and score with confidence.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/contact#enquiry" class="rounded-full bg-navy-800 px-7 py-3.5 text-center font-semibold text-white shadow-lg shadow-navy-800/20 transition hover:bg-navy-700">
            Book a free demo class
          </a>
          <a href="/courses" class="rounded-full border border-ink/15 bg-white px-7 py-3.5 text-center font-semibold text-ink transition hover:border-ink/30">
            Explore courses →
          </a>
        </div>
        <dl class="mt-10 grid max-w-lg grid-cols-3 gap-6 border-t border-ink/10 pt-6">
          <div>
            <dt class="text-xs text-ink/50">Google rating</dt>
            <dd class="font-display text-2xl font-semibold text-navy-900">{site.rating.toFixed(1)}★</dd>
          </div>
          <div>
            <dt class="text-xs text-ink/50">Happy reviews</dt>
            <dd class="font-display text-2xl font-semibold text-navy-900">{site.reviewCount}+</dd>
          </div>
          <div>
            <dt class="text-xs text-ink/50">Classes</dt>
            <dd class="font-display text-2xl font-semibold text-navy-900">1 – 12</dd>
          </div>
        </dl>
      </div>

      <div class="relative">
        <div class="absolute -top-6 -left-6 hidden h-32 w-32 rounded-3xl bg-saffron-400/40 lg:block"></div>
        <img
          src="https://images.unsplash.com/photo-1572847748080-bac263fae977?auto=format&fit=crop&w=1200&q=80"
          alt="Smiling students in a classroom"
          class="relative aspect-[4/3] w-full rounded-3xl object-cover shadow-2xl shadow-navy-900/20"
          width="1200"
          height="900"
          fetchpriority="high"
        />
        <div class="absolute -bottom-6 left-4 flex items-center gap-3 rounded-2xl bg-white p-4 shadow-xl sm:left-8">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-saffron-100 text-xl">👩‍🏫</span>
          <div>
            <p class="text-sm font-semibold">Women-owned institute</p>
            <p class="text-xs text-ink/60">Open daily till 9 PM</p>
          </div>
        </div>
        <div class="absolute -top-4 right-4 hidden max-w-[220px] rounded-2xl bg-navy-800 p-4 text-sm text-white shadow-xl sm:block">
          “Reasonable price and excellent dedication of teachers.”
          <span class="mt-1 block text-xs text-saffron-400">— Google review</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlights strip -->
  <section class="border-y border-ink/5 bg-white">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-10 gap-y-3 px-4 py-5 text-sm text-ink/60 sm:px-6">
      <span class="font-semibold text-ink">What reviewers mention most:</span>
      {reviewTags.map((t) => <span><span class="font-semibold text-navy-700">{t.label}</span> · {t.count}</span>)}
    </div>
  </section>

  <!-- Why us -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-24">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-widest text-saffron-600 uppercase">Why Easy Concepts</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-navy-900 sm:text-4xl">Coaching that feels personal — and shows in results.</h2>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((p) => (
          <div class="reveal rounded-2xl border border-ink/5 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-navy-50 text-navy-700">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d={p.icon} />
              </svg>
            </span>
            <h3 class="mt-5 text-lg font-semibold">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/65">{p.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Courses -->
  <section class="bg-navy-50/60 py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold tracking-widest text-saffron-600 uppercase">Programs</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-navy-900 sm:text-4xl">A program for every stage of school</h2>
        </div>
        <a href="/courses" class="font-semibold text-navy-700 hover:underline">View all courses →</a>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          courses.map((c) => (
            <a href={`/courses#${c.slug}`} class="reveal group overflow-hidden rounded-2xl bg-white shadow-sm transition hover:shadow-lg">
              <div class="aspect-[16/10] overflow-hidden">
                <img src={c.img} alt="" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" width="900" height="563" />
              </div>
              <div class="p-6">
                <p class="text-xs font-semibold tracking-wide text-saffron-600 uppercase">{c.level}</p>
                <h3 class="mt-1 text-lg font-semibold text-navy-900">{c.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink/65">{c.blurb}</p>
                <span class="mt-4 inline-block text-sm font-semibold text-navy-700 group-hover:underline">Learn more →</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Method -->
  <section class="mx-auto grid max-w-7xl items-center gap-14 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:py-24">
    <div class="grid grid-cols-2 gap-4">
      <img src="https://images.unsplash.com/photo-1664382953518-4a664ab8a8c9?auto=format&fit=crop&w=700&q=75" alt="Teacher explaining at the whiteboard" loading="lazy" class="aspect-[3/4] w-full rounded-2xl object-cover" width="700" height="933" />
      <img src="https://images.unsplash.com/photo-1579017308347-e53e0d2fc5e9?auto=format&fit=crop&w=700&q=75" alt="Student writing notes in a notebook" loading="lazy" class="mt-10 aspect-[3/4] w-full rounded-2xl object-cover" width="700" height="933" />
    </div>
    <div>
      <p class="text-sm font-semibold tracking-widest text-saffron-600 uppercase">The Easy Concepts method</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-navy-900 sm:text-4xl">Four steps from “I don’t get it” to “that’s easy!”</h2>
      <ol class="mt-10 space-y-6">
        {
          steps.map((s) => (
            <li class="reveal flex gap-5">
              <span class="font-display text-3xl font-semibold text-saffron-500">{s.n}</span>
              <div>
                <h3 class="font-semibold text-navy-900">{s.title}</h3>
                <p class="mt-1 text-ink/65">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Reviews -->
  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-3">
        <div>
          <p class="text-sm font-semibold tracking-widest text-saffron-600 uppercase">Parents & students</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-navy-900 sm:text-4xl">Rated 5.0 by every one of {site.reviewCount} reviewers</h2>
          <div class="mt-8 rounded-2xl bg-navy-800 p-6 text-white">
            <div class="flex items-baseline gap-3">
              <span class="font-display text-5xl font-semibold">5.0</span>
              <span class="text-xl tracking-widest text-saffron-400">★★★★★</span>
            </div>
            <p class="mt-1 text-sm text-navy-100">{site.reviewCount} reviews on Google</p>
            <ul class="mt-6 space-y-3 text-sm">
              {highlights.map((h) => <li class="border-l-2 border-saffron-400 pl-3 text-navy-100">“{h}”</li>)}
            </ul>
            <a href={site.mapsUrl} target="_blank" rel="noopener" class="mt-6 inline-block text-sm font-semibold text-saffron-400 hover:underline">Read all reviews on Google →</a>
          </div>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:col-span-2">
          {reviews.map((r) => <ReviewCard {...r} />)}
          <div class="reveal flex flex-col justify-center rounded-2xl border-2 border-dashed border-navy-100 p-7 text-center">
            <p class="font-display text-2xl font-semibold text-navy-900">Your child could be next.</p>
            <p class="mt-2 text-sm text-ink/60">Join the families who trust Easy Concepts.</p>
            <a href="/contact#enquiry" class="mx-auto mt-5 rounded-full bg-saffron-500 px-6 py-3 text-sm font-semibold text-ink hover:bg-saffron-400">Enquire now</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Location -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid overflow-hidden rounded-3xl border border-ink/5 bg-white shadow-sm lg:grid-cols-5">
      <div class="p-8 sm:p-10 lg:col-span-2">
        <p class="text-sm font-semibold tracking-widest text-saffron-600 uppercase">Visit the centre</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-navy-900">Right on Matiyala Main Road</h2>
        <dl class="mt-8 space-y-5 text-sm">
          <div><dt class="font-semibold">Address</dt><dd class="mt-1 text-ink/70">{site.address.line1}, {site.address.line2}</dd></div>
          <div><dt class="font-semibold">Phone</dt><dd class="mt-1"><a href={site.phoneHref} class="text-navy-700 hover:underline">{site.phoneDisplay}</a></dd></div>
          <div><dt class="font-semibold">Hours</dt><dd class="mt-1 text-ink/70">{site.hours}</dd></div>
          <div><dt class="font-semibold">Plus code</dt><dd class="mt-1 text-ink/70">{site.address.plusCode}</dd></div>
        </dl>
        <a href={site.mapsUrl} target="_blank" rel="noopener" class="mt-8 inline-block rounded-full bg-navy-800 px-6 py-3 text-sm font-semibold text-white hover:bg-navy-700">Get directions</a>
      </div>
      <iframe
        title="Easy Concepts on Google Maps"
        src={site.mapsEmbed}
        class="h-80 w-full border-0 lg:col-span-3 lg:h-full"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>

  <CtaBand />

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <h2 class="text-center font-display text-3xl font-semibold tracking-tight text-navy-900 sm:text-4xl">Frequently asked questions</h2>
    <div class="mt-10 divide-y divide-ink/10 rounded-2xl border border-ink/5 bg-white px-6 shadow-sm">
      {
        faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-navy-900">
              {f.q}
              <span class="ml-4 text-xl text-saffron-600 transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-ink/70">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</Layout>
