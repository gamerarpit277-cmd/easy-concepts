---
import { nav, site } from "../data/site";
import Logo from "./Logo.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<div class="bg-navy-900 text-xs text-navy-100">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2 sm:px-6">
    <p class="truncate">
      <span class="text-saffron-400">★ {site.rating.toFixed(1)}</span> on Google · {site.reviewCount} reviews · Admissions open for 2026–27
    </p>
    <a href={site.phoneHref} class="hidden shrink-0 font-semibold text-white hover:text-saffron-400 sm:block">{site.phoneDisplay}</a>
  </div>
</div>

<header class="sticky top-0 z-30 border-b border-ink/5 bg-paper/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
    <a href="/" aria-label={`${site.name} home`}><Logo /></a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "text-sm font-medium transition hover:text-navy-600",
              path === item.href ? "text-navy-700" : "text-ink/70",
            ]}
            aria-current={path === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/contact#enquiry"
        class="hidden rounded-full bg-saffron-500 px-5 py-2.5 text-sm font-semibold text-ink shadow-sm transition hover:bg-saffron-400 sm:inline-block"
        >Book free demo</a
      >
      <button
        id="menu-btn"
        class="rounded-lg p-2 text-ink md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"
          ><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path></svg
        >
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-ink/5 bg-paper px-4 pb-4 md:hidden" aria-label="Mobile">
    {
      nav.map((item) => (
        <a href={item.href} class="block border-b border-ink/5 py-3 font-medium text-ink/80">
          {item.label}
        </a>
      ))
    }
    <a href="/contact#enquiry" class="mt-4 block rounded-full bg-saffron-500 py-3 text-center font-semibold text-ink">Book free demo</a>
  </nav>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-nav");
  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(open));
  });
</script>
