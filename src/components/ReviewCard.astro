---
interface Props {
  name: string;
  meta: string;
  when: string;
  title?: string;
  text: string;
  reply?: string;
}
const { name, meta, when, title, text, reply } = Astro.props;
const initials = name
  .split(" ")
  .map((p) => p[0])
  .join("")
  .slice(0, 2);
---

<figure class="reveal flex h-full flex-col rounded-2xl border border-ink/5 bg-white p-6 shadow-sm shadow-ink/5 sm:p-7">
  <div class="flex items-center justify-between">
    <span class="text-lg tracking-widest text-saffron-500" aria-label="5 out of 5 stars">★★★★★</span>
    <svg viewBox="0 0 48 48" class="h-6 w-6" aria-label="Google review"
      ><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.4-.4-3.5z"
      ></path><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"
      ></path><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"
      ></path><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"></path></svg
    >
  </div>
  <blockquote class="mt-4 flex-1 text-[15px] leading-relaxed text-ink/80">
    {title && <p class="mb-2 font-display text-lg font-semibold text-navy-900">“{title}”</p>}
    <p>{text}</p>
  </blockquote>
  {
    reply && (
      <div class="mt-5 rounded-xl bg-navy-50 p-4 text-sm text-ink/70">
        <p class="mb-1 text-xs font-semibold tracking-wide text-navy-700 uppercase">Response from Easy Concepts</p>
        {reply}
      </div>
    )
  }
  <figcaption class="mt-5 flex items-center gap-3 border-t border-ink/5 pt-5">
    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-saffron-100 text-sm font-bold text-saffron-600">{initials}</span>
    <span>
      <span class="block font-semibold text-ink">{name}</span>
      <span class="block text-xs text-ink/50">{meta} · {when}</span>
    </span>
  </figcaption>
</figure>
