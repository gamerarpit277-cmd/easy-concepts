---
import { site } from "../data/site";
---

<section class="px-4 py-16 sm:px-6">
  <div class="bg-grid-light relative mx-auto max-w-7xl overflow-hidden rounded-3xl bg-navy-800 px-6 py-14 text-center sm:px-12">
    <div class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-saffron-500/20 blur-3xl"></div>
    <p class="text-sm font-semibold tracking-widest text-saffron-400 uppercase">Admissions open</p>
    <h2 class="mx-auto mt-3 max-w-2xl font-display text-3xl font-semibold text-white sm:text-4xl">
      Come see why parents in Matiala rate us 5.0★
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-navy-100">
      Sit in on a free demo class, meet the teachers and see how we make every concept easy.
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/contact#enquiry" class="rounded-full bg-saffron-500 px-7 py-3.5 font-semibold text-ink transition hover:bg-saffron-400">Book a free demo class</a>
      <a href={site.phoneHref} class="rounded-full border border-white/25 px-7 py-3.5 font-semibold text-white transition hover:bg-white/10">Call {site.phoneDisplay}</a>
    </div>
  </div>
</section>
