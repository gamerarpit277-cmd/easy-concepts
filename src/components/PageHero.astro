---
interface Props {
  eyebrow: string;
  title: string;
  text: string;
}
const { eyebrow, title, text } = Astro.props;
---

<section class="bg-grid border-b border-ink/5">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
    <p class="text-sm font-semibold tracking-widest text-saffron-600 uppercase">{eyebrow}</p>
    <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold tracking-tight text-navy-900 sm:text-5xl">{title}</h1>
    <p class="mt-5 max-w-2xl text-lg text-ink/70">{text}</p>
  </div>
</section>
